# Sandbox in which Claude Code (binary mounted read-only at runtime) operates on one task repo.
# pytest-cov and pytest-xdist are deliberately absent: some cascade injections depend on that.
# Keep Python at 3.11: T02 cascade c1 imports math.sumprod, which only exists from 3.12 on; on a
# newer base image that cascade would silently stop breaking anything.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ripgrep procps ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir pytest==8.3.3
RUN git config --system user.email agent@example.org && git config --system user.name agent \
    && git config --system --add safe.directory '*'
WORKDIR /work
